---
interface Props {
  generatedAt: string;
}
const { generatedAt } = Astro.props;
---
<footer>
  <div class="wrap">
    ALIGNUX · datos generados por <code>tools/status-export.py</code> desde la API de GitHub.
    <span id="footer-fresh" class="muted">· última exportación {new Date(generatedAt).toISOString().replace('T', ' ').slice(0, 16)} UTC</span>
  </div>
</footer>
