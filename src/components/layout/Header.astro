---
interface Props {
  activeTab: string;
}
const { activeTab } = Astro.props;

const tabs = [
  { id: 'estado', label: 'Estado' },
  { id: 'arquitectura', label: 'Arquitectura' },
  { id: 'comparativa', label: 'Comparativa' },
  { id: 'roadmap', label: 'Roadmap' },
  { id: 'tareas', label: 'Tareas' },
  { id: 'validacion', label: 'Validación' },
  { id: 'riesgos', label: 'Riesgos' },
  { id: 'fuentes', label: 'Fuentes' },
];
---
<header class="top">
  <div class="wrap">
    <div class="brand">ALIGN<span class="dot">UX</span></div>
    <p class="subtitle">sistema operativo microkernel sobre seL4 · estado vivo del proyecto</p>
    <nav class="tabs" role="tablist" aria-label="Secciones del panel">
      {tabs.map((tab) => (
        <button
          type="button"
          class="tab-btn"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={tab.id === activeTab}
          tabindex={tab.id === activeTab ? 0 : -1}
          data-tab={tab.id}
        >
          {tab.label}
        </button>
      ))}
      <div class="theme-toggle-container" style="margin-left: auto;"></div>
    </nav>
  </div>
</header>

<script type="module">
  import { initTabs } from '/scripts/tabs.js';
  initTabs('estado');
</script>
